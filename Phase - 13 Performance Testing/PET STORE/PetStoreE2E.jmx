              <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor">
                <boolProp name="resetInterpreter">false</boolProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">

import java.util.regex.Matcher;
import java.util.regex.Pattern;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;workingItemId\\=([^\&quot;]+)&quot;);
Matcher matcher = pattern.matcher(response);

java.util.ArrayList workingItemIds = new java.util.ArrayList();

int index = 1;

while (matcher.find()) {
    String id = matcher.group(1);
	workingItemIds.add(id);
    vars.put(&quot;workingItemIds_&quot; + index, id);

    index++;
}

vars.put(&quot;workingItemCount&quot;, String.valueOf(index - 1));</stringProp>
