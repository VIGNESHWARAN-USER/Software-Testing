            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="Radom Pet Name Extractor">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.util.Random;

String response = prev.getResponseDataAsString();

Pattern pattern = Pattern.compile(&quot;categoryId=([A-Z]+)&quot;);
Matcher matcher = pattern.matcher(response);


java.util.ArrayList pets = new java.util.ArrayList();

while (matcher.find()) {
    pets.add(matcher.group(1));
}

if (!pets.isEmpty()) {
    Random random = new Random();

 
    int randomIndex = random.nextInt(pets.size());

 
    String randomPet = (String) pets.get(randomIndex);

    vars.put(&quot;pet&quot;, randomPet);

    log.info(&quot;PET: &quot; + randomPet);
} else {
    log.error(&quot;No Pets found.&quot;);
}</stringProp>
            </BeanShellPostProcessor>
