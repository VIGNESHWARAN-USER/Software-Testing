                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def firstNumber = vars.get(&quot;firstNumber&quot;)
def secondNumber = vars.get(&quot;secondNumber&quot;)

println(firstNumber)
println(secondNumber)

if (!firstNumber || !secondNumber) {
    throw new IllegalStateException(
        &quot;Required values missing: addNumber=${firstNumber}, magic=${secondNumber}&quot;
    )
}

long magicNumber = firstNumber.toLong() + secondNumber.toLong()
vars.put(&quot;Magic Number&quot;, magicNumber.toString())

log.info(&quot;MagicNumber calculation: ${firstNumber} + ${secondNumber} = ${magicNumber}&quot;)</stringProp>
              </JSR223PreProcessor>
